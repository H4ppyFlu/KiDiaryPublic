# Copy to .env and fill in PIN and SESSION_SECRET; the stack refuses to start without
# them. Everything else here is what Compose already falls back to.
POSTGRES_USER=kidiary
POSTGRES_PASSWORD=kidiary
POSTGRES_DB=kidiary

# DATABASE_URL is not set here: Compose assembles it from the three values above and
# passes it to the API.

# Who the Diary is about and who keeps it. These are recorded on the first start, while
# the database has no Child yet; after that the record stands and a change here is only
# logged, so that a restart without this file can never replace a captured birthdate.
CHILD_NAME=Kind
CHILD_BIRTHDATE=2024-01-01
PARENT_ONE_NAME=Mama
PARENT_TWO_NAME=Papa

# The family's timezone. A Diary day and a notification time both mean local time.
TIMEZONE=Europe/Berlin

# The PIN both parents type once per device, and the secret that signs the cookie they
# get for it. There are no defaults for these: a PIN in the repository is not a PIN.
# Changing SESSION_SECRET signs every device out; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PIN=
SESSION_SECRET=

# The key pair that identifies this Pi to the push services, so that a notification
# sent from here is accepted as coming from the same sender the phone subscribed to.
# Generate a pair once and paste both lines in:
#   docker compose run --rm --no-deps api python -m app.vapid
# Leave them empty and everything else still works; the app then says plainly that
# notifications are not set up here. Changing either half silently stops every device
# that has already subscribed, so they are worth keeping alongside the backups.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who a push service can complain to about this sender, and it must be an address that
# could actually receive mail. RFC 8292 asks for a contact and requires nobody to check
# it, but Apple does check: a subject it will not accept comes back as
#   403 {"reason":"BadJwtToken"}
# at the hour the notification was due, against a subscription that is perfectly valid.
# `mailto:kidiary@localhost` used to be the default here and is exactly such an address,
# so this has no default at all now — a stack with keys and no real contact refuses to
# start rather than going quiet on the first evening somebody was expecting.
#
# It is an abuse contact rather than an identity: it exists so a push service operator
# can reach whoever is sending, and nothing ever verifies it or delivers to it. RFC 8292
# allows an https: URL as readily as a mailto:, which is worth knowing — a repository URL
# serves the purpose without handing a personal mailbox to Apple and Google.
VAPID_SUBJECT=https://github.com/H4ppyFlu/KiDiaryPublic

# On the Pi only: make a plain `docker compose ...` mean this file *and* the Pi's overrides,
# so that the command which brings the Diary up there is the one already in muscle memory.
# The separator is a colon on Linux and a semicolon on Windows. Leave it out on the laptop.
#COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml

# Mark the sign-in cookie `Secure`. Leave false on http://localhost. On the Pi there is
# nothing to set: `docker-compose.pi.yml` forces it to true, so that no line missing from
# this file and no copy of it brought over from the laptop can hand out a year-long cookie
# that travels in the clear.
COOKIE_SECURE=false

# The nightly dump (ADR-0008). BACKUP_DIR is the directory on this machine the dumps
# land in — on the Pi, the one Syncthing mirrors to the laptop. BACKUP_KEEP is how many
# nightly dumps are kept before the oldest is removed; they are kilobytes, so a longer
# memory costs nothing. The hour is not here on purpose: a dump is taken a quarter past
# four, because that is when a Diary day has closed, which makes it a fact about the
# Diary rather than a setting.
BACKUP_DIR=./backups
BACKUP_KEEP=7
